# Owner console (platform) settings. Copy to platform/.env.
PORT=4000
# Required, at least 16 characters: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
TZ=Asia/Kolkata

# Your ERP domain: schools get <subdomain>.BASE_DOMAIN, the console is served at console.BASE_DOMAIN
BASE_DOMAIN=erp.example.in
# How school backends reach this console for their licence (same server → localhost)
PUBLIC_URL=http://127.0.0.1:4000

# Where each school's data/uploads/backups and its backend .env are created
SCHOOLS_DIR=/var/erp/schools
# The ERP code checked out on this server
BACKEND_DIR=/opt/school-erp/backend
FRONTEND_DIR=/opt/school-erp/frontend
FRONTEND_PORT=3000
# First port handed to a new school's backend (each school gets the next free one)
PORT_RANGE_START=6101

# Generated config files
ECOSYSTEM_PATH=/opt/school-erp/ecosystem.config.js
NGINX_CONF_PATH=/etc/nginx/sites-enabled/erp-schools.conf
# wildcard: one certificate for *.BASE_DOMAIN (recommended) · none: plain HTTP while setting up
SSL_MODE=wildcard
CERT_NAME=erp.example.in

# Until this is true, "Apply" only shows the commands it would run.
APPLY_ENABLED=false
# Prefix pm2/nginx commands with "sudo -n" (needs a sudoers rule for exactly those commands)
USE_SUDO=false
