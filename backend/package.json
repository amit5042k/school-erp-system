{
  "name": "school-erp-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/utils/seed.js",
    "seed:dev": "node src/utils/seed.js --force --dev",
    "init": "node src/utils/init.js",
