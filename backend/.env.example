PORT=5000
# Required, at least 16 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
DB_PATH=./data/school.sqlite
# School timezone, used for "today" (attendance, dashboard, overdue fees)
TZ=Asia/Kolkata

# --- Optional: email (SMTP). Leave SMTP_HOST empty to disable; messages are then logged as "not configured".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=School Office <office@school.example>

# --- Optional: SMS through your provider's HTTP API. {to} and {message} are filled in for each recipient.
# SMS_API_URL=https://your-sms-provider/send?apikey=KEY&sender=SCHOOL&numbers={to}&message={message}
# SMS_API_METHOD=GET
# For POST providers, also set a JSON body template:
# SMS_API_BODY={"to":"{to}","text":"{message}"}

# --- Files and backups
# UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=15
# BACKUP_DIR=./data/backups
BACKUP_KEEP=14
# BACKUP_DISABLED=true
# Off-site copy of every backup to S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, Wasabi):
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   (or https://s3.ap-south-1.amazonaws.com)
# BACKUP_S3_BUCKET=school-erp-backups
# BACKUP_S3_REGION=auto            (AWS: e.g. ap-south-1)
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=school-erp/

# --- Optional: Web Push keys for app notifications. Left empty, a key pair is generated on first start and kept in the
# database. Set these only to choose your own (generate with: npx web-push generate-vapid-keys).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:office@yourschool.in
